FROM swarm-formation-upstream:noetic AS qn_query_build

COPY integration/qn_aav_simulator/src/qn_aav_simulator /tmp/query_source/qn_aav_simulator
COPY integration/mrta_python/build_query_extensions.py /tmp/build_query_extensions.py
RUN python3 -m pip install --no-cache-dir --no-deps --target /tmp/query_build_tools Cython==3.2.9 && \
    PYTHONPATH=/tmp/query_build_tools python3 /tmp/build_query_extensions.py \
      --source-dir /tmp/query_source/qn_aav_simulator --output-dir /workspace/query_extensions

FROM swarm-formation-upstream:noetic

# Only the bounded-query worker enables these private modules after checking
# source hashes and ABI. The online qn/PVS processes retain the source package.
COPY --from=qn_query_build /workspace/query_extensions /workspace/query_extensions

COPY integration/qn_aav_simulator /workspace/src/src/qn_aav_simulator
COPY integration/mrta_python /workspace/integration/mrta_python
COPY upstream/Fossen/src/python_vehicle_simulator /workspace/integration/python_vehicle_simulator
COPY upstream/Fossen/LICENSE /workspace/integration/python_vehicle_simulator/LICENSE
COPY integration/swarm_qn_bridge/simulator.xml \
  /workspace/src/src/planner/plan_manage/launch/simulator.xml

# The upstream CPU renderer latches the first global map and ignores later ones,
# which would make a deliberately injected obstacle invisible to the planners.
# The patch is applied here so the upstream snapshot stays untouched.
COPY integration/swarm_qn_bridge/patches /tmp/swarm_qn_patches
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/pcl_render_node_accept_map_updates.patch
# The renderer must publish a completed empty scan (with a real stamp and the
# same frame as the rest of the stack) instead of staying silent.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/renderer_empty_scan_frame_stamp.patch
# The replan FSM must honour the goal height so the cruise altitude can clear the
# declared surface envelope.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/plan_manage_honour_goal_height.patch
# The formation goal entry always adds the member's slot offset, the goal topic is
# one global broadcast, and SEQUENTIAL_START makes drone_id >= 1 wait for a
# predecessor trajectory.  All three block commanding a subset of members.  This
# adds a per-member goal entry (position used as-is, no predecessor wait) and a
# parameterised formation topic, with the defaults preserving upstream behaviour.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/plan_manage_member_goal_entry.patch
# The formation slot layout and shape live in a hard-coded file inside the node
# definition, so a three-member configuration cannot supply its own.  Make it an
# argument with the upstream default.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/plan_manage_formation_config_arg.patch
# The desired formation set must be declarable: formation_type=1 hard-codes seven
# nodes, so a three-member unit silently skips the similarity cost.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/traj_opt_declared_formation.patch

# Reuse a native stationary reference for already-settled adapted goals.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/plan_manage_stationary_goal.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/plan_manage_safety_hold.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/plan_manage_reference_handover.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/root_finder_degenerate_bound.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/traj_opt_finite_commit.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/swarm_readonly_query.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/swarm_reference_time.patch
# Optional physical peer clearance contract; the three-AAV launch enables it.
# The upstream seven-member configuration keeps its existing thresholds.
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/swarm_peer_safety_contract.patch
RUN patch -p1 -d /workspace/src \
      < /tmp/swarm_qn_patches/swarm_reference_sampling.patch
COPY integration/swarm_qn_bridge/src/swarm_readonly_query.cpp \
  /workspace/src/src/planner/plan_manage/src/swarm_readonly_query.cpp

# matplotlib is in the base image but its Tk bindings are not, so the live
# dashboard could only publish images.  This layer adds them; nothing else in
# the stack depends on it.
RUN apt-get update && apt-get install -y --no-install-recommends python3-tk fonts-noto-cjk

# mrta_python is a path-based package (integration/mrta_python).  The base
# image ships setuptools 45.2, whose isolated PEP 621 build needs PyPI and
# whose non-isolated build drops the package metadata; keeping it on
# PYTHONPATH makes the image build offline-friendly and deterministic.
ENV PYTHONPATH=/workspace/integration
RUN . /opt/ros/noetic/setup.sh && cd /workspace && catkin_make -j2

RUN echo "source /workspace/devel/setup.bash" >> /root/.bashrc

WORKDIR /workspace
CMD ["bash"]
