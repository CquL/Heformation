+
+// Private complete static map for read-only optimizer queries. Inflation and
+// vertical ceiling follow the CPU cloud path; no ROS I/O is registered here.
+void GridMap::loadStaticSnapshot(const std::vector<Eigen::Vector3d> &points)
+{
+  resetBuffer();
+  const int inflation = ceil(mp_.obstacles_inflation_ / mp_.resolution_);
+  for (const auto &point : points)
+    for (int x=-inflation; x<=inflation; ++x)
+      for (int y=-inflation; y<=inflation; ++y)
+        for (int z=-1; z<=1; ++z)
+          setOccupied(point + mp_.resolution_ * Eigen::Vector3d(x,y,z));
+  if (mp_.virtual_ceil_height_ > -0.5) {
+    const int z=floor((mp_.virtual_ceil_height_-mp_.map_origin_(2))*mp_.resolution_inv_);
+    for (int x=0; x<mp_.map_voxel_num_(0); ++x)
+      for (int y=0; y<mp_.map_voxel_num_(1); ++y)
+        if (isInMap(Eigen::Vector3i(x,y,z))) md_.occupancy_buffer_inflate_[toAddress(Eigen::Vector3i(x,y,z))]=1;
+  }
+  updateESDF3d();
 }
 
