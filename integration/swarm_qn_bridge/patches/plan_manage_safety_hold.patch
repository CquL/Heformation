+  bool EGOReplanFSM::ordinaryReferenceAllowed()
+  {
+    std::lock_guard<std::recursive_mutex> guard(reference_mutex_);
+    return !safety_hold_latched_;
+  }
+
+  void EGOReplanFSM::safetyCloudCallback(const sensor_msgs::PointCloud2ConstPtr &msg)
+  {
+    // A stamped, well-framed empty scan is a completed sensor observation.
+    const double age = (ros::Time::now() - msg->header.stamp).toSec();
+    if (msg->header.frame_id == "world" && !msg->header.stamp.isZero() &&
+        age >= 0.0 && age <= safety_cloud_timeout_ && msg->header.stamp >= last_safety_cloud_)
+      last_safety_cloud_ = msg->header.stamp;
+  }
+
+  void EGOReplanFSM::latchSafetyHold(const std::string &reason)
+  {
+    std::lock_guard<std::recursive_mutex> guard(reference_mutex_);
+    if (safety_hold_latched_) return;
+    safety_hold_latched_ = true;
+    safety_reason_ = reason;
+    safety_latched_at_ = ros::Time::now();
+    enable_fail_safe_ = false;
+    have_target_ = false;
+    have_new_target_ = false;
+    const double age = (safety_latched_at_ - last_safety_odom_).toSec();
+    safety_hold_point_valid_ = have_odom_ && !last_safety_odom_.isZero() &&
+        age >= 0.0 && age <= safety_odom_timeout_ && odom_pos_.allFinite() && odom_vel_.allFinite();
+    if (safety_hold_point_valid_)
+    {
+      safety_hold_point_ = odom_pos_;
+      // Use the upstream stationary polynomial without modifying qn control.
+      planner_manager_->EmergencyStop(safety_hold_point_);
+      traj_utils::PolyTraj msg;
+      polyTraj2ROSMsg(msg);
+      safety_trajectory_id_ = msg.traj_id;
+      poly_traj_pub_.publish(msg);
+      broadcast_ploytraj_pub_.publish(msg);
+      safety_hold_published_ = true;
+    }
+    else safety_publication_error_ = "ODOMETRY_UNRELIABLE";
+    changeFSMExecState(EMERGENCY_STOP, "LATCHED_SAFETY_HOLD");
+    publishSafetyStatus();
+  }
+
+  bool EGOReplanFSM::safetyHoldRequest(std_srvs::Trigger::Request &, std_srvs::Trigger::Response &res)
+  {
+    latchSafetyHold("EXTERNAL_HOLD_REQUEST");
+    res.success = true; // Acceptance only. diagnostics and qn prove publication/adoption.
+    res.message = "safety hold latched; resource recovery requires whole-chain restart";
+    return true;
+  }
+
+  void EGOReplanFSM::safetyHoldTick(const ros::WallTimerEvent &)
+  {
+    if (safety_hold_armed_ && !last_safety_cloud_.isZero() &&
+        (ros::Time::now() - last_safety_cloud_).toSec() > safety_cloud_timeout_)
+      latchSafetyHold("LOCAL_CLOUD_STALE");
+    publishSafetyStatus();
+  }
+
+  void EGOReplanFSM::publishSafetyStatus()
+  {
+    diagnostic_msgs::DiagnosticArray array;
+    array.header.stamp = ros::Time::now();
+    diagnostic_msgs::DiagnosticStatus status;
+    status.name = "local_safety_hold";
+    status.hardware_id = "drone_" + std::to_string(planner_manager_->pp_.drone_id);
+    status.level = safety_hold_latched_ ? diagnostic_msgs::DiagnosticStatus::WARN : diagnostic_msgs::DiagnosticStatus::OK;
+    status.message = safety_reason_;
+    auto add = [&status](const std::string &key, const std::string &value) {
+      diagnostic_msgs::KeyValue entry; entry.key = key; entry.value = value; status.values.push_back(entry);
+    };
+    auto number = [](double value) { std::ostringstream stream; stream << std::setprecision(17) << value; return stream.str(); };
+    add("latched", safety_hold_latched_ ? "true" : "false");
+    add("armed", safety_hold_armed_ ? "true" : "false");
+    add("reason", safety_reason_);
+    add("latched_at_s", number(safety_latched_at_.toSec()));
+    add("last_cloud_stamp_s", number(last_safety_cloud_.toSec()));
+    add("last_odom_stamp_s", number(last_safety_odom_.toSec()));
+    add("point_valid", safety_hold_point_valid_ ? "true" : "false");
+    add("reference_published", safety_hold_published_ ? "true" : "false");
+    add("trajectory_id", std::to_string(safety_trajectory_id_));
+    add("hold_x", number(safety_hold_point_.x())); add("hold_y", number(safety_hold_point_.y())); add("hold_z", number(safety_hold_point_.z()));
+    add("publication_error", safety_publication_error_);
+    array.status.push_back(status);
+    safety_status_pub_.publish(array);
+  }
+
 } // namespace ego_planner
