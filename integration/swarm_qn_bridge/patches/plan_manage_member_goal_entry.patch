+  // The member entry: end_pt_ is the received world position itself.  The
+  // formation callback deliberately adds swarm_scale_ * swarm_relative_pts_[id],
+  // which is right for a formation centre and wrong for a single-member target
+  // (and wrong for a hold command, which would push the member off its hold).
+  void EGOReplanFSM::memberWaypointCallback(const geometry_msgs::PoseStampedPtr &msg)
+  {
+    if (msg->pose.position.z < -0.1)
+      return;
+
+    member_goal_active_ = true;
+
+    ROS_INFO("member goal received: %.3f %.3f %.3f",
+             msg->pose.position.x, msg->pose.position.y, msg->pose.position.z);
+    cout << "Member goal triggered!" << endl;
+    init_pt_ = odom_pos_;
+
+    // Assign the member, not a shadowing local: the FSM plans from end_pt_ and
+    // a local copy leaves it at its default (0, 0, 0), which sends the member to
+    // the origin instead of its target.
+    end_pt_ << msg->pose.position.x, msg->pose.position.y, msg->pose.position.z;
+
+    std::vector<Eigen::Vector3d> one_pt_wps;
+    one_pt_wps.push_back(end_pt_);
+
+    bool success = planner_manager_->planGlobalTrajWaypoints(
+        odom_pos_, odom_vel_, Eigen::Vector3d::Zero(),
+        one_pt_wps, Eigen::Vector3d::Zero(), Eigen::Vector3d::Zero());
+
+    visualization_->displayGoalPoint(end_pt_, Eigen::Vector4d(0, 0.5, 0.5, 1), 0.3, 0);
+
+    if (success)
+    {
+      constexpr double step_size_t = 0.1;
+      int i_end = floor(planner_manager_->traj_.global_traj.duration / step_size_t);
+      vector<Eigen::Vector3d> gloabl_traj(i_end);
+      for (int i = 0; i < i_end; i++)
+      {
+        gloabl_traj[i] = planner_manager_->traj_.global_traj.traj.getPos(i * step_size_t);
+      }
+
+      end_vel_.setZero();
+      have_target_ = true;
+      have_new_target_ = true;
+
+      if (exec_state_ == WAIT_TARGET)
+        changeFSMExecState(SEQUENTIAL_START, "TRIG");
+      else if (exec_state_ == EXEC_TRAJ)
+        changeFSMExecState(REPLAN_TRAJ, "TRIG");
+
+      visualization_->displayGlobalPathList(gloabl_traj, 0.1, 0);
+    }
+    else
+    {
+      ROS_ERROR("Unable to generate global trajectory for a member goal!");
+    }
+  }
