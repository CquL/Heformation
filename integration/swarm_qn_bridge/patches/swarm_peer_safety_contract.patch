@@ -0,0 +1,40 @@
+#ifndef SWARM_PEER_SAFETY_HPP
+#define SWARM_PEER_SAFETY_HPP
+
+#include <algorithm>
+#include <cmath>
+
+namespace ego_planner
+{
+// The command server holds the endpoint after a polynomial ends. A polynomial
+// with a future start does not describe its member before that start, so never
+// evaluate it at negative local time. This is sampled nominal-reference safety,
+// not a continuous-time proof or a bound on closed-loop tracking error.
+template <typename Trajectory>
+bool peerTrajectoryConflict(const Trajectory &own, double own_start,
+                            const Trajectory &peer, double peer_start,
+                            double from, double until, double clearance,
+                            double *first_conflict = nullptr)
+{
+  const double own_duration = own.getTotalDuration();
+  const double peer_duration = peer.getTotalDuration();
+  const double begin = std::max(from, std::max(own_start, peer_start));
+  if (!(clearance > 0.0) || !(own_duration > 0.0) || !(peer_duration > 0.0) ||
+      !std::isfinite(begin) || !std::isfinite(until) || until < begin)
+    return false;
+  constexpr double step = 0.01; // same sampling period as the native collision scan
+  for (double at = begin;; at = std::min(until, at + step))
+  {
+    const auto own_position = own.getPos(std::min(own_duration, at - own_start));
+    const auto peer_position = peer.getPos(std::min(peer_duration, at - peer_start));
+    if ((own_position - peer_position).norm() < clearance)
+    {
+      if (first_conflict) *first_conflict = at;
+      return true;
+    }
+    if (at >= until) break;
+  }
+  return false;
+}
+} // namespace ego_planner
+#endif
