   // formation callback deliberately adds swarm_scale_ * swarm_relative_pts_[id],
   // which is right for a formation centre and wrong for a single-member target
   // (and wrong for a hold command, which would push the member off its hold).
+  // Reuse the native stationary MinJerk trajectory for a settled goal within
+  // the FSM's existing 0.1 m endpoint resolution. Publish a real new trajectory;
+  // adoption is still confirmed independently from qn consuming that id.
+  // Restricted to the opt-in member entry; the seven-member path is unchanged.
+  bool EGOReplanFSM::publishStationaryReference()
+  {
+    if (!member_entry_enabled_ || !have_odom_ ||
+        (end_pt_ - odom_pos_).norm() >= 0.1 || odom_vel_.norm() >= 0.1)
+      return false;
+    callEmergencyStop(odom_pos_);
+    traj_utils::PolyTraj msg;
+    polyTraj2ROSMsg(msg);
+    broadcast_ploytraj_pub_.publish(msg);
+    local_target_pt_ = end_pt_;
+    end_vel_.setZero();
+    have_target_ = true;
+    have_local_traj_ = true;
+    have_new_target_ = false;
+    changeFSMExecState(EXEC_TRAJ, "STATIONARY_GOAL");
+    ROS_INFO("stationary goal: published new native trajectory");
+    return true;
+  }
