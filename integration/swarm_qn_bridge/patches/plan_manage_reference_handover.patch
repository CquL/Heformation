+
+  void EGOReplanFSM::referenceContextCallback(const diagnostic_msgs::DiagnosticArrayConstPtr &msg)
+  {
+    std::lock_guard<std::recursive_mutex> guard(reference_mutex_);
+    const double age = (ros::Time::now() - msg->header.stamp).toSec();
+    if (msg->header.stamp.isZero() || age < 0.0 || age > safety_odom_timeout_ ||
+        msg->header.stamp < reference_context_time_) return;
+    std::string source, generation;
+    const std::string member = "drone_" + std::to_string(planner_manager_->pp_.drone_id);
+    for (const auto &status : msg->status)
+      if (status.hardware_id == member)
+        for (const auto &entry : status.values)
+        {
+          if (entry.key == "requested_reference_source") source = entry.value;
+          if (entry.key == "reference_generation") generation = entry.value;
+        }
+    if (source != "AIR_SWARM" && source != "PLATFORM") return;
+    unsigned int next;
+    try { next = std::stoul(generation); } catch (...) { return; }
+    if (reference_context_known_ && next < reference_generation_) return;
+    const bool paused = source != "AIR_SWARM";
+    if (reference_context_known_ && next == reference_generation_ &&
+        paused != ordinary_reference_paused_) return;
+    reference_context_time_ = msg->header.stamp;
+    if (!reference_context_known_ || next != reference_generation_)
+    {
+      ++reference_commit_epoch_;
+      reference_generation_ = next;
+      ordinary_reference_paused_ = paused;
+      reference_floor_id_ = planner_manager_->traj_.local_traj.traj_id;
+      ordinary_goal_after_ = msg->header.stamp;
+      // A subsequent AIR goal must plan from current odometry, not old local
+      // trajectory continuation. Keep trajectory ids and fault history intact.
+      have_target_ = have_new_target_ = have_local_traj_ = false;
+      if (!safety_hold_latched_) changeFSMExecState(WAIT_TARGET, "REFERENCE_HANDOVER");
+      reference_context_known_ = true;
+      publishSafetyStatus();
+    }
   }
 
