<launch>
  <!-- Single member handover qualification in the existing three-AAV world.
       The other members remain physically present; no qn instance restarts. -->
  <arg name="output_dir" default="/experiments/current"/>
  <arg name="record" default="true"/>
  <arg name="observed_mapping" default="false"/>
  <arg name="swarm_run_launch" default="$(find ego_planner)/launch/run_in_sim.launch"/>
  <arg name="transition_fault_behavior" default="FIXED_REFERENCE"/>
  <arg name="planner_speed" default="0.35"/>
  <!-- A user-selected offshore region can put a member target more than 30 m
       from the deployment area.  This is an observation horizon, not a looser
       arrival or safety threshold; the Action still has to settle and pass the
       existing hold, clearance and reference-adoption checks. -->
  <arg name="air_observation_timeout_s" default="350.0"/>
  <include file="$(find qn_aav_simulator)/launch/formation_aav3.launch">
    <arg name="swarm_run_launch" value="$(arg swarm_run_launch)"/>
    <arg name="observed_mapping" value="$(arg observed_mapping)"/>
    <arg name="planner_speed" value="$(arg planner_speed)"/>
    <arg name="safety_hold_timeout_s" value="$(arg air_observation_timeout_s)"/>
    <arg name="record" value="false"/>
    <arg name="output_dir" value="$(arg output_dir)"/>
  </include>
  <param name="drone_0_ego_planner_node/fsm/reference_handover_enabled" value="true"/>
  <param name="drone_0_qn_aav/enable_platform_action" value="true"/>
  <param name="drone_0_qn_aav/reference_handover_enabled" value="true"/>
  <param name="drone_0_qn_aav/qualification_only" value="true"/>
  <param name="drone_0_qn_aav/transition_fault_behavior" value="$(arg transition_fault_behavior)"/>
  <param name="drone_0_qn_aav/world_frame" value="world"/>
  <param name="drone_0_qn_aav/water_guidance_mode" value="LOS_VELOCITY_REFERENCE"/>
  <param name="drone_0_qn_aav/water_horizontal_controller_mode" value="LOS_SURGE_YAW"/>
  <param name="drone_1_ego_planner_node/fsm/reference_handover_enabled" value="true"/>
  <param name="drone_1_qn_aav/enable_platform_action" value="true"/>
  <param name="drone_1_qn_aav/reference_handover_enabled" value="true"/>
  <param name="drone_1_qn_aav/qualification_only" value="true"/>
  <param name="drone_1_qn_aav/transition_fault_behavior" value="$(arg transition_fault_behavior)"/>
  <param name="drone_1_qn_aav/world_frame" value="world"/>
  <param name="drone_1_qn_aav/water_guidance_mode" value="LOS_VELOCITY_REFERENCE"/>
  <param name="drone_1_qn_aav/water_horizontal_controller_mode" value="LOS_SURGE_YAW"/>
  <param name="drone_2_ego_planner_node/fsm/reference_handover_enabled" value="true"/>
  <param name="drone_2_qn_aav/enable_platform_action" value="true"/>
  <param name="drone_2_qn_aav/reference_handover_enabled" value="true"/>
  <param name="drone_2_qn_aav/qualification_only" value="true"/>
  <param name="drone_2_qn_aav/transition_fault_behavior" value="$(arg transition_fault_behavior)"/>
  <param name="drone_2_qn_aav/world_frame" value="world"/>
  <param name="drone_2_qn_aav/water_guidance_mode" value="LOS_VELOCITY_REFERENCE"/>
  <param name="drone_2_qn_aav/water_horizontal_controller_mode" value="LOS_SURGE_YAW"/>
  <node if="$(arg record)" pkg="rosbag" type="record" name="handover_recorder"
    args="-O $(arg output_dir)/handover.bag --buffsize=256 --regex /aav_(1|2|3|formation)/formation_action/.*|/drone_0_qn_aav/(platform_task/.*|local_products)|/drone_[0-2]_qn/(odometry|used_reference_pose|used_reference_twist|diagnostics|medium_flag)|/drone_0_planning/(trajectory|pos_cmd|safety_status)|/drone_0_(member|formation)_goal|/(usv|uuv)/(odometry|diagnostics|local_products|platform_task/.*)|/mother/received_.*|/scene/(global_cloud|delivery_progress)"/>
</launch>
