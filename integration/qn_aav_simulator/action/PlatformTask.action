string task_id
qn_aav_simulator/PlatformSegment[] segments
# Only explicitly qualified terminal behavior is accepted.
string terminal_behavior
duration execution_timeout
# Default false preserves standalone qualification goals. True accepts/reserves
# the fragment but holds its qualified initial behavior until explicit release.
bool prepare_only
# Point IDs in the request loaded once by the local endpoint. Empty means
# motion only; a successful motion Result is never an observation product.
string[] observation_ids
# Additional bounded time in the qualified terminal behavior. Integration,
# safety checks and physical reservation continue; this is not position reset.
duration terminal_wait
---
string task_id
string goal_id
bool task_completed
bool terminal_verified
string actual_mode
string reason
bool resource_locked
float64 model_time_s
---
uint32 segment_index
string operation
string reference_source
string actual_mode
uint32 reference_generation
float64 model_time_s
