<launch>

    <arg name="map_size_x" value="23.183098861837905"/>
    <arg name="map_size_y" value="23.183098861837905"/>
    <arg name="map_size_z" value="3.0"/>
    <arg name="odom_topic" value="visual_slam/odom" />

    <!-- swarm topic transmitter bridge-->
    <include file="$(find swarm_bridge)/launch/bridge_udp.launch">
    <arg name="drone_id" value="0"/>
    <arg name="broadcast_ip" value="127.0.0.255"/>
    </include> 

    <!-- map --> 
	<node pkg ="map_generator" name ="random_forest" type ="random_forest" output = "screen">
        <param name="map/x_size"     value="0.8367035798005"/>
        <param name="map/y_size"     value="0.8367035798005"/>
        <param name="map/z_size"     value="3.0" />
        <param name="map/resolution" value="0.1"/>
        <param name="map/obs_num"    value="0.35003644022548586"/>
        <param name="ObstacleShape/lower_rad" value="0.2"/>
        <param name="ObstacleShape/upper_rad" value="0.5"/>
        <param name="ObstacleShape/lower_hei" value="0.0"/>
        <param name="ObstacleShape/upper_hei" value="3.0"/>
        <param name="map/circle_num" value="0.35003644022548586"/>
        <param name="ObstacleShape/radius_l" value="0.7"/>
        <param name="ObstacleShape/radius_h" value="0.5"/>
        <param name="ObstacleShape/z_l" value="0.7"/>
        <param name="ObstacleShape/z_h" value="0.8"/>
        <param name="ObstacleShape/theta" value="0.5"/>
        <param name="pub_rate"   value="1.0"/>
        <param name="min_distance" value="0.8"/>
    </node> 

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find primitive_planner)/launch/verbose.rviz" required="true" />

    <include file="$(find primitive_planner)/launch/run_in_sim.xml">
        <arg name="drone_id"   value="0"/>
        <arg name="init_x"     value="1.5915494309189535"/>
        <arg name="init_y"     value="0.0"/>
        <arg name="init_z"     value="0.5"/>
        <arg name="target0_x"   value="-1.5915494309189535"/>
        <arg name="target0_y"   value="-0.0"/>
        <arg name="target0_z"   value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
    <include file="$(find primitive_planner)/launch/run_in_sim.xml">
        <arg name="drone_id"   value="1"/>
        <arg name="init_x"     value="0.4918158215417331"/>
        <arg name="init_y"     value="1.513653457281314"/>
        <arg name="init_z"     value="0.5"/>
        <arg name="target0_x"   value="-0.4918158215417331"/>
        <arg name="target0_y"   value="-1.513653457281314"/>
        <arg name="target0_z"   value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
    <include file="$(find primitive_planner)/launch/run_in_sim.xml">
        <arg name="drone_id"   value="2"/>
        <arg name="init_x"     value="-1.2875905370012097"/>
        <arg name="init_y"     value="0.9354892837886393"/>
        <arg name="init_z"     value="0.5"/>
        <arg name="target0_x"   value="1.2875905370012097"/>
        <arg name="target0_y"   value="-0.9354892837886393"/>
        <arg name="target0_z"   value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
    <include file="$(find primitive_planner)/launch/run_in_sim.xml">
        <arg name="drone_id"   value="3"/>
        <arg name="init_x"     value="-1.28759053700121"/>
        <arg name="init_y"     value="-0.9354892837886389"/>
        <arg name="init_z"     value="0.5"/>
        <arg name="target0_x"   value="1.28759053700121"/>
        <arg name="target0_y"   value="0.9354892837886389"/>
        <arg name="target0_z"   value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
    <include file="$(find primitive_planner)/launch/run_in_sim.xml">
        <arg name="drone_id"   value="4"/>
        <arg name="init_x"     value="0.4918158215417327"/>
        <arg name="init_y"     value="-1.5136534572813143"/>
        <arg name="init_z"     value="0.5"/>
        <arg name="target0_x"   value="-0.4918158215417327"/>
        <arg name="target0_y"   value="1.5136534572813143"/>
        <arg name="target0_z"   value="0.5"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
</launch>